# ============================================
# Конфигурация SearXNG Docker (2026)
# Основано на официальном шаблоне
# Скопируйте в .env и настройте под себя:
#   cp .env.example .env
# ============================================

# Версия Docker-образа (latest или конкретная версия, например "2026.3.25-541c6c3cb")
#SEARXNG_VERSION=latest

# Адрес, на котором слушает SearXNG (оставьте пустым для всех интерфейсов)
#SEARXNG_HOST=

# Порт, на котором будет доступен SearXNG
SEARXNG_PORT=8080

# ============================================
# Дополнительные настройки SearXNG
# https://docs.searxng.org/admin/settings/settings_general.html
# https://docs.searxng.org/admin/settings/settings_server.html
# ============================================

# Название инстанса
SEARXNG_INSTANCE_NAME=SearXNG

# Базовый URL (важно для корректных ссылок)
SEARXNG_BASE_URL=http://localhost:8080/

# Секретный ключ (ОБЯЗАТЕЛЬНО смените!)
# Генерация: openssl rand -hex 32
SEARXNG_SECRET=changeme

# Движок автодополнения (google, duckduckgo, wikipedia, startpage, brave, или пустая строка)
SEARXNG_AUTOCOMPLETE=google
