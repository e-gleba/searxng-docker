# =============================================================================
# SearXNG Docker — Environment Configuration
# =============================================================================
# Copy this file to .env and customize:
#
#   cp .env.example .env
#   $EDITOR .env
#
# Generate a secret key:
#   openssl rand -hex 32
# =============================================================================

# ---------------------------------------------------------------------------
# SearXNG Core
# ---------------------------------------------------------------------------

# Host port mapped to the SearXNG container (default: 8080)
SEARXNG_PORT=8080

# Public-facing base URL (update if behind a reverse proxy)
SEARXNG_BASE_URL=http://localhost:8080/

# Secret key for session encryption (REQUIRED)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Docker image — use upstream or the pre-built GHCR image
# SEARXNG_IMAGE=searxng/searxng:latest
# SEARXNG_IMAGE=ghcr.io/e-gleba/searxng-docker:latest

# ---------------------------------------------------------------------------
# Valkey Cache
# ---------------------------------------------------------------------------

# Valkey image tag
VALKEY_VERSION=8-alpine

# Maximum memory for Valkey cache
VALKEY_MAX_MEMORY=256mb
