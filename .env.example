# ============================================
# SearXNG Docker — переменные окружения
#
# Этот файл НЕОБЯЗАТЕЛЬНЫЙ для запуска.
# Все настройки SearXNG (порт, URL, движки) — в core-config/settings.yml
# ============================================

# Тег образа SearXNG (latest или конкретная версия)
# SEARXNG_VERSION=latest

# ============================================
# MCP сервер (для LLM клиентов)
# ============================================

# URL MCP сервера (для подключения из LLM клиентов)
# Используется в настройках Claude Desktop, Cursor, LM Studio, Ollama
# MCP_URL=http://localhost:8000/mcp

# Часовой пояс для MCP datetime tool
# MCP_TIMEZONE=Europe/Moscow

# Максимум страниц для скрейпинга за поиск
# MCP_SCRAPPED_PAGES_NO=5

# Максимум слов на страницу
# MCP_PAGE_CONTENT_WORDS_LIMIT=5000

# Rate limiting (запросов в минуту на домен)
# MCP_RATE_LIMIT_REQUESTS_PER_MINUTE=10
