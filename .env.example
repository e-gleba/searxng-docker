# ============================================
# Конфигурация SearXNG Docker
# Скопируйте в .env и настройте под себя:
#   cp .env.example .env
# ============================================

# Порт, на котором будет доступен SearXNG
SEARXNG_PORT=8080

# Тег Docker-образа (latest или конкретная версия)
SEARXNG_IMAGE_TAG=latest

# Название инстанса, отображаемое в интерфейсе
INSTANCE_NAME=SearXNG

# Движок автодополнения (google, duckduckgo, wikipedia, startpage — или пустая строка для отключения)
AUTOCOMPLETE=google

# Публичный URL инстанса (важно для корректных ссылок и CORS)
BASE_URL=http://localhost:8080/
