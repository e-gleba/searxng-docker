# ============================================
# SearXNG Docker — Environment Variables
#
# This file is OPTIONAL.
# All SearXNG settings (port, URL, engines) are in core-config/settings.yml
# ============================================

# SearXNG image tag (latest or specific version)
# SEARXNG_VERSION=latest

# SearXNG secret key (generate with: openssl rand -hex 32)
# SEARXNG_SECRET=your-secret-key-here

# Base URL for SearXNG
# SEARXNG_BASE_URL=http://localhost:8080/
