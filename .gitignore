# =============================================================================
# Git Ignore Rules — SearXNG Docker
# =============================================================================

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local

# Docker volumes (runtime data)
/data/
/cache/
/logs/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE and editor files
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.history/

# Secrets and keys
core-config/searxng.key
core-config/favicons.toml
*.pem
*.key
*.crt
*.p12

# Build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# Backup files
*.orig
*.backup
*~

# Test coverage
htmlcov/
.coverage
coverage.xml

# Node modules (if any frontend tools)
node_modules/
package-lock.json
yarn.lock

# Terraform (if infrastructure code added)
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
