# =============================================================================
# Docker Ignore Rules — SearXNG Docker
# =============================================================================
# Files excluded from Docker build context to reduce image size and build time
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Docker
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Documentation (not needed in image)
README.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
LICENSE
*.md
docs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Data volumes (runtime data)
data/
core-data/
valkey-data/
logs/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
.venv
*.egg-info/

# Build artifacts
build/
dist/
*.egg

# Test files
tests/
.pytest_cache/
.coverage
htmlcov/

# CI/CD configuration
.github/
.travis.yml
.circleci/

# Terraform (if present)
.terraform/
*.tfstate*

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.log
